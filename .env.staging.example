# Local staging for the agent. The backend repo's docs/team/staging.md says how
# to run both. Copy to .env.staging (gitignored) and fill in the blanks. Never
# commit .env.staging; never paste its values into a PR, a report or a log.

# --- Which environment this is.
RETROSPECT_ENV=staging
# Read this file instead of .env, and let it win over the shell (an exported
# production value must never reach staging).
DOTENV_CONFIG_PATH=.env.staging
DOTENV_CONFIG_OVERRIDE=true
NODE_ENV=development
PORT=3001

# --- The staging Supabase project (retrospect-staging), never production's.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
# Direct Postgres string, for npm run db:migrate:staging only.
DATABASE_URL=
# Path to Supabase's CA certificate (dashboard → Database settings → SSL
# configuration → download), so db:migrate:staging verifies the connection.
DATABASE_CA_CERT=

# --- The same value as INTERNAL_API_SECRET in the backend's .env.staging.
INTERNAL_API_SECRET=
ADMIN_SECRET=

# --- Model providers. A placeholder keeps model calls off (they fail, nothing
# is spent); real keys only when a test needs a real model, logged as test spend.
OPENAI_API_KEY=staging-no-model-key
ANTHROPIC_API_KEY=staging-no-model-key
PERPLEXITY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# The whole staging project's model spend per 24 hours (enforced from BEA.4).
STAGING_DAILY_CAP_USD=5

# --- Every background job off: staging runs only what a test asks for.
ENABLE_AGENT_CRONS=false
ENABLE_DAILY_BRIEF=false
ENABLE_MATERIAL_ARRIVALS=false
ENABLE_ONBOARDING_PIPELINE=false
ENABLE_QUESTION_RESEARCH=false
ENABLE_INTEGRATION_RUNTIME=false
ENABLE_INTEGRATION_WORKER=false
ENABLE_INTEGRATION_SCHEDULER=false
INTEGRATION_SCHEDULER_POLL_MINUTES=15
INTEGRATION_SYNC_INTERVAL_MINUTES=360
INTEGRATION_WORKER_CONCURRENCY=3
INTEGRATION_WORKER_POLL_MS=3000
INTEGRATION_WORKER_LEASE_SECONDS=1800

# --- Integrations. Empty: connecting a provider on staging is out of scope.
INTEGRATION_KMS_KEY_ID=
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# openssl rand -base64 32, only if a test stores integration credentials.
INTEGRATION_LOCAL_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Errors. With a DSN set, staging errors are tagged "staging" (RETROSPECT_ENV).
SENTRY_DSN=
