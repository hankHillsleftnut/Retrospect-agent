# Supabase (share existing Retrospect project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# OpenAI
OPENAI_API_KEY=sk-...

# Perplexity (for the agent's internet_research tool)
PERPLEXITY_API_KEY=pplx-...

# ElevenLabs (optional — runs with --skip-tts work without these)
# Hardcoded persona voice IDs (Rachel/Adam/Antoni) are built in.
# Set ELEVENLABS_VOICE_ID to override all personas with one voice.
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=

# Server
PORT=3001
NODE_ENV=development

# Optional: admin secret for manual-trigger endpoints
ADMIN_SECRET=change-me

# Existing agent service can host the integration scheduler + worker in-process.
# Keep this false locally unless you want background jobs running.
ENABLE_INTEGRATION_RUNTIME=false
ENABLE_INTEGRATION_WORKER=false
ENABLE_INTEGRATION_SCHEDULER=false
INTEGRATION_SCHEDULER_POLL_MINUTES=15
INTEGRATION_SYNC_INTERVAL_MINUTES=360
INTEGRATION_WORKER_CONCURRENCY=3
INTEGRATION_WORKER_POLL_MS=3000
INTEGRATION_WORKER_LEASE_SECONDS=1800

# Durable integration jobs and encrypted credential vault
INTERNAL_API_SECRET=generate-a-long-random-shared-secret
INTEGRATION_KMS_KEY_ID=arn:aws:kms:us-west-2:ACCOUNT:key/KEY_ID
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local development only: `openssl rand -base64 32`
INTEGRATION_LOCAL_ENCRYPTION_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
