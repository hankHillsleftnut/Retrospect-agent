{
  "name": "retrospect-agent",
  "version": "0.1.0",
  "description": "Agent-based podcast generation and daily ingestion. Sibling to Retrospect, shares the same Supabase database.",
  "main": "dist/src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp -r src/public dist/src/public",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/ingest.ts",
    "cookA": "tsx scripts/cookA.ts",
    "cookB": "tsx scripts/cookB.ts",
    "cookC": "tsx scripts/cookC.ts",
    "podcast": "tsx scripts/podcast.ts",
    "replay": "tsx scripts/replay.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "scenarios": "tsx scripts/scenarios.ts",
    "backfill": "tsx scripts/backfill-embeddings.ts",
    "doctor": "tsx scripts/doctor.ts",
    "setup": "tsx scripts/setup.ts"
  },
  "keywords": [
    "agent",
    "podcast",
    "retrospect",
    "ingestion"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "openai": "^4.24.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
