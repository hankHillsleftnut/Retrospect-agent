{
  "name": "retrospect-agent",
  "version": "0.1.0",
  "description": "Agent-based podcast generation and daily ingestion. Sibling to Retrospect, shares the same Supabase database.",
  "main": "dist/src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/public dist/src/public",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/ingest.ts",
    "cookA": "tsx scripts/cookA.ts",
    "cookB": "tsx scripts/cookB.ts",
    "cookC": "tsx scripts/cookC.ts",
    "podcast": "tsx scripts/podcast.ts",
    "replay": "tsx scripts/replay.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "scenarios": "tsx scripts/scenarios.ts",
    "backfill": "tsx scripts/backfill-embeddings.ts",
    "doctor": "tsx scripts/doctor.ts",
    "integration:smoke": "tsx scripts/integration-smoke.ts",
    "integration:worker": "tsx src/jobs/integration-worker.ts",
    "integration:schedule": "tsx src/jobs/integration-scheduler.ts",
    "security:check": "node scripts/check-secrets.cjs",
    "test": "tsx --test $(find tests -name '*.test.ts')",
    "setup": "tsx scripts/setup.ts",
    "lint:brain": "tsx scripts/lint.ts",
    "requeue": "tsx scripts/requeue-failed.ts",
    "health": "tsx scripts/health.ts",
    "db:check": "tsx scripts/schema-check.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "questions:first-pass": "tsx scripts/questions-first-pass.ts",
    "bank:score": "tsx scripts/bank-score.ts",
    "import:transcript": "tsx scripts/import-transcript.ts",
    "questions:research": "tsx scripts/questions-research.ts",
    "costs": "tsx scripts/costs.ts",
    "brief": "tsx scripts/daily-brief.ts",
    "e2e:onboarding": "tsx scripts/e2e-onboarding.ts",
    "eval:brain": "tsx scripts/eval-brain.ts",
    "events:report": "tsx scripts/events-report.ts",
    "summaries:rebuild": "tsx scripts/rebuild-summaries.ts",
    "eval:guard": "tsx scripts/eval-guard.ts",
    "eval:search": "tsx scripts/eval-search.ts",
    "trust:backfill": "tsx scripts/backfill-trust.ts",
    "eval:corrections": "tsx scripts/eval-corrections.ts",
    "eval:conversation": "tsx scripts/eval-conversation.ts",
    "import:youtube": "tsx scripts/import-youtube-takeout.ts"
  },
  "keywords": [
    "agent",
    "podcast",
    "retrospect",
    "ingestion"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@aws-sdk/client-kms": "^3.1068.0",
    "@sentry/node": "^10.58.0",
    "@supabase/supabase-js": "^2.39.0",
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.7",
    "adm-zip": "^0.5.17",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "gpt-tokenizer": "^4.0.0",
    "node-cron": "^3.0.3",
    "openai": "^4.24.0",
    "pg": "^8.23.1",
    "typescript": "^5.3.3",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "@types/pg": "^8.23.1",
    "tsx": "^4.7.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
